# ---------------------------------------------------------------
# WargaKu .gitignore
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build output
dist/
dist-ssr/
dev-dist/
build/
*.tsbuildinfo

# Environment & secrets — JANGAN pernah commit kunci Supabase
.env
.env.*
!.env.example
*.pem
*.key

# Supabase CLI (lokal)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/functions/.env

# Vercel
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/
.nyc_output/

# Cache
.cache/
.vite/
.eslintcache
.stylelintcache

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Claude Code — pengaturan pribadi
.claude/settings.local.json

# Impeccable — file kerja lokal (DESIGN.md & design.json tetap di-commit)
.impeccable/config.local.json
.impeccable/review/
.impeccable/build/
.impeccable/live/
